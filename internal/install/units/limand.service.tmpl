# systemd unit for the liman daemon, a text/template: "limand install"
# writes it, for the engine and the proxy chosen, as
# /etc/systemd/system/limand.service.
#
#   systemctl status limand        is it running, and its last log lines
#   journalctl -u limand -f        follow its log
#   systemctl restart limand       running deploys finish first (see below)

[Unit]
Description=liman daemon (deploys containers{{if .ProxyName}} behind {{.ProxyName}}{{end}})
Documentation=https://github.com/onrcanogul/liman

# Ordering only: start after these if they are being started too. The
# WireGuard unit is named here because the daemon usually listens on the
# WireGuard address, which does not exist before the interface is up. A
# unit that does not exist on this machine is ignored.
After=network-online.target {{.EngineUnit}}{{if .ProxyUnit}} {{.ProxyUnit}}{{end}} wg-quick@wg0.service
# Wants pulls a unit in without tying this one's life to it. Requires would
# stop the daemon whenever Docker is restarted; the daemon copes with that
# on its own and reports "cannot reach Docker" in the meantime.
Wants=network-online.target {{.EngineUnit}}

[Service]
Type=simple
ExecStart=/usr/local/bin/limand

# A user of its own, so the daemon's files belong to nobody else and nothing
# else's files belong to it.
{{- if .RuntimeDir}}
# The engine is this user's own rootless Podman: its containers run under
# the user's subordinate ids, and taking over the daemon gives the liman
# user's rights, not root's.
{{- else}}
# Access to the engine's socket (the docker group, or Podman's socket
# given to the liman group) is what lets it start containers. That access
# is equivalent to root (anyone who can talk to the engine can mount the
# host's disk); the separate user protects against accidents, not against
# a compromised daemon.
{{- end}}
User=liman
Group=liman
{{- if .SupplementaryGroup}}
SupplementaryGroups={{.SupplementaryGroup}}
{{- end}}

# The database, the master key and config.yaml live here. systemd creates
# /var/lib/liman with these permissions before the first start.
Environment=LIMAN_HOME=/var/lib/liman
{{- if .RuntimeDir}}
# Where rootless Podman's socket and podman login's credentials are.
Environment=XDG_RUNTIME_DIR={{.RuntimeDir}}
{{- end}}
StateDirectory=liman
StateDirectoryMode=0700

# If the daemon exits with an error it is started again. That also covers
# a boot where the WireGuard address was not there yet.
Restart=on-failure
RestartSec=5s

# "systemctl stop" sends SIGTERM. The daemon then waits up to two minutes
# for running deploys to finish or roll back; systemd must wait longer than
# that before it resorts to SIGKILL (the default would be 90 seconds).
KillSignal=SIGTERM
TimeoutStopSec=150s

# Sandboxing. Each line takes away something the daemon has no use for.
#
# /usr, /boot and /etc are read-only for the daemon, except the one
# directory it writes the proxy's config into.
ProtectSystem=full
{{- if .ConfDir}}
ReadWritePaths=-{{.ConfDir}}
{{- end}}
{{- if .RuntimeDir}}
# /home and /root do not exist for it, nor /run/user but for its own
# directory there, which holds Podman's socket. (The plain "true" setting
# would hide that one too.)
ProtectHome=tmpfs
BindPaths={{.RuntimeDir}}
{{- else}}
# /home and /root do not exist for it.
ProtectHome=true
{{- end}}
# A /tmp of its own, removed when it stops.
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
# No access to disks and other hardware as device files.
PrivateDevices=true
# It may not set the clock or the host name.
ProtectClock=true
ProtectHostname=true
# It may not create containers of its own (Docker does that, in another
# process), switch to a legacy execution mode or ask for real-time
# scheduling, which could starve the machine.
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
# Only the kinds of socket it uses: local ones (Docker, systemd) and IP.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Only this machine's own instruction set; closes a route around system
# call filters.
SystemCallArchitectures=native
# Files it creates are for its own user unless it says otherwise.
UMask=0077
# NoNewPrivileges is deliberately absent: the daemon reloads its proxy
# through sudo ("systemctl reload nginx", and for Nginx "nginx -t"), which
# is the one thing that option forbids. What it may run through sudo is
# limited to exactly those commands (see /etc/sudoers.d/liman). That is not
# the same as "cannot become root": the proxy, running as root or its own
# user, reads the config files this user writes, and such a config can name
# files to read and to write. It adds nothing to what access to the engine
# already allows, but it is the reason the content of those files is built
# only from validated values.

[Install]
# Start at boot.
WantedBy=multi-user.target
